# Included by Ubuntu's nginx.conf inside the http block.
map $http_cloudfront_forwarded_proto $magnolia_forwarded_proto {
    default $scheme;
    http http;
    https https;
}

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    client_max_body_size 50m;
    # Keep Nginx redirects on the viewer hostname and protocol.
    absolute_redirect off;
    # Author responses, login cookies, readiness, and errors must stay fresh.
    add_header Cache-Control "no-store, private" always;
    access_log /var/log/nginx/magnolia-access.log;
    error_log /var/log/nginx/magnolia-error.log;

    location = / {
        return 302 /magnoliaAuthor/;
    }

    location = /magnoliaAuthor {
        return 302 /magnoliaAuthor/;
    }

    location /magnoliaAuthor/ {
        # No URI suffix: preserve the context and readiness path unchanged.
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $magnolia_forwarded_proto;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_connect_timeout 5s;
    }

    location / {
        return 404;
    }
}
